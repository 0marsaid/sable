# Sable — copy to .env and fill in. Never commit .env.
# Empty values are fine while you are only checking that the server boots.

PORT=8787
HOST=0.0.0.0

# web (default when WhatsApp is not configured) or whatsapp.
CHANNEL=web
# Password for the website. There is no sign-up. Use a long password.
APP_PASSWORD=

# What the bot calls itself, and what it calls you.
ASSISTANT_NAME=Sable
OWNER_NAME=Omar
# IANA timezone. Used when turning "tomorrow at 9" into a real moment.
OWNER_TIMEZONE=America/Los_Angeles

# Comma-separated WhatsApp numbers allowed to talk to Sable.
# Anyone else is ignored. Include country code. Example: +15551234567
OWNER_PHONE_NUMBERS=

# SQLite file. The default is a local file. Render's free plan has no
# persistent disk, so this file resets on every redeploy, restart, and spin-down.
DATABASE_PATH=./data/sable.db

# Public https origin, no trailing slash. Used for Twilio signature checks
# and shown in the logs so you know which webhook URL to paste into Meta.
# Example: https://sable.example.com
PUBLIC_BASE_URL=

LOG_LEVEL=info

# ----- Language model (OpenAI-compatible chat completions) -----
# openai: real model. mock: local echo, no network, for a dry run.
LLM_MODE=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional. Used only for turns that include a photo. Falls back to LLM_MODEL.
LLM_VISION_MODEL=

# ----- WhatsApp -----
# meta: official Cloud API. twilio: Twilio WhatsApp sandbox. console: local dry run.
# Leave unset to auto-pick meta, then twilio, then console, based on which keys exist.
WHATSAPP_PROVIDER=

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# App secret enables X-Hub-Signature-256 checks. Leave empty only for local curl.
META_APP_SECRET=
META_API_VERSION=v21.0
# Optional. When set, reminders go out as this approved template (one body variable)
# so they still send after WhatsApp's 24-hour reply window. See the README.
META_REMINDER_TEMPLATE=
META_REMINDER_TEMPLATE_LANG=en

# Twilio WhatsApp (alternate adapter)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ----- Web search -----
# tavily, brave, or none. Auto-picks whichever key you set.
SEARCH_PROVIDER=none
TAVILY_API_KEY=
BRAVE_API_KEY=
